# Clinical Navigator — variables locales et production
# Ne commitez jamais les valeurs réelles dans ce fichier.

# Serveur
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@host:3306/clinical_navigator
JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=owner-open-id
CRON_SECRET=remplacer-par-un-secret-cron-long

# Intégration Manus / Forge côté serveur uniquement
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=server-only-key

# Client Vite — seules les variables VITE_* sont exposées au navigateur.
VITE_APP_ID=clinical-navigator
VITE_OAUTH_PORTAL_URL=https://oauth.example.com
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com
VITE_FRONTEND_FORGE_API_KEY=public-or-scoped-client-key
# true pour GitHub Pages/Netlify/Cloudflare sans backend ; false seulement avec un backend tRPC joignable.
VITE_STATIC_ONLY=true
# Origine optionnelle d’un backend tRPC séparé. Vide = /api/trpc same-origin.
VITE_API_BASE_URL=
VITE_BASE_PATH=/

# Déploiement Vercel / CI — à configurer dans les secrets du fournisseur, jamais dans Git.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
